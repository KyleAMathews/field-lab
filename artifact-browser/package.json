{
  "name": "artifact-browser",
  "private": true,
  "type": "module",
	"scripts": {
		"artifact-browser": "tsx src/cli/index.ts",
		"field-lab": "tsx src/field-lab-cli/index.ts",
		"field-log": "tsx src/field-log-cli/index.ts",
		"expedition-log": "tsx src/expedition-log-cli/index.ts",
		"dev": "vite dev",
		"build": "vite build && pnpm build:cli && pnpm build:field-lab && pnpm build:field-log && pnpm build:expedition-log",
		"build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli/index.js",
		"build:field-lab": "esbuild src/field-lab-cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/field-lab-cli/index.js",
		"build:field-log": "esbuild src/field-log-cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/field-log-cli/index.js",
		"build:expedition-log": "esbuild src/expedition-log-cli/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/expedition-log-cli/index.js",
    "preview": "vite preview",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "test": "vitest run",
    "test:conformance": "vitest run src/field-lab/conformance",
    "test:skill-live": "FIELD_LAB_LIVE=1 vitest run src/field-lab/conformance/live-skill.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
	"bin": {
		"artifact-browser": "./dist/cli/index.js",
		"field-lab": "./dist/field-lab-cli/index.js",
		"field-log": "./dist/field-log-cli/index.js",
		"expedition-log": "./dist/expedition-log-cli/index.js"
  },
  "dependencies": {
    "@capsizecss/metrics": "^4.2.0",
    "@durable-streams/client": "^0.2.6",
    "@durable-streams/server": "^0.3.8",
    "@durable-streams/state": "^0.3.1",
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/lato": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/db": "^0.6.17",
    "@tanstack/highlight": "^0.0.9",
    "@tanstack/query-db-collection": "^1.2.1",
    "@tanstack/react-db": "^0.1.95",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/router-plugin": "^1.168.23",
    "ajv": "8.20.0",
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.27.0",
    "mermaid": "^11.16.0",
    "mime": "^4.1.0",
    "open": "^11.0.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "vite-plugin-capsize-radix": "^0.2.4",
    "xstate": "5.32.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@tanstack/intent": "^0.3.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "@tanstack/db": "0.6.17"
    }
  }
}
